{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoHarvester Knowledge Branch",
  "type": "object",
  "required": ["branch_key", "status", "branch_type", "owner_agent", "github_paths", "notion_page", "dependencies", "exclusions", "retrieval_packet", "tracking"],
  "properties": {
    "branch_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["active", "incubating", "candidate", "paused", "archived", "superseded"]},
    "branch_type": {"enum": ["core", "feature", "simulation", "runtime", "tooling", "research"]},
    "owner_agent": {"type": "string", "minLength": 1},
    "github_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "notion_page": {"type": "string", "pattern": "^https://app\\.notion\\.com/p/"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "retrieval_packet": {"type": "string", "minLength": 1},
    "tracking": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
