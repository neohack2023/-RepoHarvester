{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoHarvester MASON Write Plan",
  "type": "object",
  "required": ["write_plan_id", "source_stone_manifest_id", "resolved_scope", "authorization_class", "operations", "preconditions", "freshness_checks", "rollback_plan", "verification_plan", "plan_digest"],
  "properties": {
    "write_plan_id": {"type": "string"},
    "source_stone_manifest_id": {"type": "string"},
    "resolved_scope": {"const": "repo-harvester"},
    "authorization_class": {"enum": ["A0", "A1", "A2", "A3"]},
    "operations": {"type": "array", "minItems": 1},
    "preconditions": {"type": "array"},
    "freshness_checks": {"type": "array"},
    "rollback_plan": {"type": "array"},
    "verification_plan": {"type": "array"},
    "plan_digest": {"type": "string"}
  }
}
